# 小王子 Agent — 环境变量配置模板
# 复制为 .env 并按需修改

# ============================================
# LLM Provider（选其一）
# ============================================
# 支持的 provider: deepseek, minimax, openai, qwen, moonshot, zhipu, custom
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
# 可选模型（不同 provider 有不同默认值）
# DEEPSEEK_MODEL=deepseek-v4-pro

# MiniMax（支持多媒体）
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your-key-here

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# ============================================
# 服务器配置
# ============================================
# 后端监听端口（默认 3721）
LITTLE_PRINCE_AGENT_PORT=3721

# 监听地址（云部署时保持 127.0.0.1，让 nginx 反向代理）
LITTLE_PRINCE_AGENT_HOST=127.0.0.1

# API 令牌认证（可选，建议启用）
# 手机客户端需在请求头添加 Authorization: Bearer <token>
LITTLE_PRINCE_AGENT_API_TOKEN=

# ============================================
# 云部署优化（VPS 上设置以下变量跳过本地扫描）
# ============================================
# 跳过桌面快捷方式扫描（无桌面环境的服务器）
LITTLE_PRINCE_AGENT_SKIP_DESKTOP_SCAN=1
# 跳过已安装软件扫描
LITTLE_PRINCE_AGENT_SKIP_SOFTWARE_SCAN=1
# 跳过 SSH/Git 等本地资源扫描
LITTLE_PRINCE_AGENT_SKIP_LOCAL_RESOURCES_SCAN=1

# 信任反向代理（启用后从 X-Forwarded-For 取客户端 IP）
LITTLE_PRINCE_AGENT_TRUST_PROXY=1

# 允许的来源域名（逗号分隔，除 localhost 外的额外允许源）
# LITTLE_PRINCE_AGENT_ALLOWED_ORIGINS=https://agent.example.com

# ============================================
# 语音配置（通过 Brain UI 设置页配置，也可在此预设）
# ============================================
# TTS 提供商: volc | minimax | openai | elevenlabs
# TTS_PROVIDER=volc
# VOLC_ACCESS_KEY=your-key
# VOLC_SECRET_KEY=your-secret

# 云端 ASR（语音识别）
# ASR_PROVIDER=aliyun
# ALIYUN_ASR_APPKEY=your-appkey

# ============================================
# 联网搜索（可选，用于增强搜索质量）
# ============================================
# SERPER_API_KEY=your-key
# BRAVE_API_KEY=your-key

# ============================================
# 嵌入模型（可选，用于记忆向量检索）
# ============================================
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_KEY=sk-your-key
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
